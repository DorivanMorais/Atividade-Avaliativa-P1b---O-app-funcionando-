<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora de Impressão 3D</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <h1>Custo de Impressão 3D</h1>
        <p>Calcule o valor do seu protótipo</p>
    </header>

    <main>
        <section class="calculator-card">
            <div class="input-group">
                <label for="spoolPrice">Preço do Carretel 1kg (R$):</label>
                <input type="number" id="spoolPrice" min="0" step="0.01" placeholder="Ex: 120.00" required>
            </div>
            
            <div class="input-group">
                <label for="partWeight">Peso da peça (gramas):</label>
                <input type="number" id="partWeight" min="0" step="1" placeholder="Ex: 150" required>
            </div>

            <div class="input-group">
                <label for="printTime">Tempo de impressão (horas):</label>
                <input type="number" id="printTime" min="0" step="0.5" placeholder="Ex: 4" required>
            </div>

            <button id="calculateBtn">Calcular Custo</button>

            <div id="resultArea" class="result-area">
                <p id="resultMessage">Preencha os dados e clique em calcular.</p>
            </div>
        </section>
    </main>

    <script src="script.js"></script>
</body>
</html>
